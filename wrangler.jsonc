{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nrepfl",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4184c683-e329-4335-8b7c-66ee0c038ac5","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8416e5c68c754c40a68e55a8c6e58cc2" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
